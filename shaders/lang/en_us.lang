option.VOLUME_TEMPORAL=Cloud and shaft history
option.VOLUME_TEMPORAL.comment=Alternates cloud refresh in stable views; shafts always sample current occlusion and smooth only close matches. Falls back for dynamic projection or a full custom-image budget.
value.VOLUME_TEMPORAL.0=Off
value.VOLUME_TEMPORAL.1=Stable views
option.LOCAL_SCATTER_ADAPTIVE=Adaptive local scattering
option.LOCAL_SCATTER_ADAPTIVE.comment=Long rays use fine near and coarser far integration, retaining empty-tile skips and continuous transmission.
value.LOCAL_SCATTER_ADAPTIVE.0=Original
value.LOCAL_SCATTER_ADAPTIVE.1=Adaptive

screen.PHYSICAL_SKY=Physical atmosphere
option.ATMO_PREBAKED=Static atmosphere tables
option.ATMO_PREBAKED.comment=Loads offline transmittance and multiple scattering; original GPU setup remains selectable.
value.ATMO_PREBAKED.0=GPU setup
value.ATMO_PREBAKED.1=Precomputed
option.ATMO_UPDATE_MODE=Atmosphere table updates
option.ATMO_UPDATE_MODE.comment=Refresh sky and aerial tables after altitude, sun elevation or maximum age changes; skip zero-contribution night work; falls back to every frame when custom-image slots are full.
value.ATMO_UPDATE_MODE.0=Every frame
value.ATMO_UPDATE_MODE.1=Change-driven

option.END_NEBULA_ASSET=Precomputed End nebula
option.END_NEBULA_ASSET.comment=Offline spherical wisps texture with original purple radiance formula; stars remain analytically antialiased. Disable for procedural nebula.
value.END_NEBULA_ASSET.0=Procedural
value.END_NEBULA_ASSET.1=Precomputed

option.CLOUD_DENSITY_CACHE=Combined cloud density cache
option.CLOUD_DENSITY_CACHE.comment=Wind-space ring cache, with live weather and vertical profile. Off restores three noise octaves.
value.CLOUD_DENSITY_CACHE.0=Off
value.CLOUD_DENSITY_CACHE.1=On
option.CLOUD_OPTICAL_CACHE=Solar optical density reuse
option.CLOUD_OPTICAL_CACHE.comment=Reuse the same combined cloud map for shifted solar optical thickness; off restores direct density.
value.CLOUD_OPTICAL_CACHE.0=Direct
value.CLOUD_OPTICAL_CACHE.1=Cached

option.SKY_ENV_REUSE=Sky environment lookup optimization
option.SKY_ENV_REUSE.comment=Shared endpoint-dense angular LUT for sky, reflection and aerial lookup; avoids per-pixel acos. Off restores old mapping.
value.SKY_ENV_REUSE.0=Original grid
value.SKY_ENV_REUSE.1=Optimized grid
