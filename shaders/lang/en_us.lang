value.WATER_PHASE_LUT.1=Texture experiment
option.BRDF_REUSE=PBR material reuse
option.BRDF_REUSE.comment=Share view Fresnel and SSR weights; skip zero-weight sky evaluation.
value.BRDF_REUSE.0=Original
value.BRDF_REUSE.1=Reuse

