#version 430 core
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(r32ui,binding=0) readonly uniform uimage3D dirtyTiles;
uniform int tileCount;
layout(std430,binding=0) buffer ActiveTiles {
    uint count1; uint y1; uint z1; uint pad1;
    uint count2; uint y2; uint z2; uint pad2;
    uint tasks1[32768];
    uint tasks2[32768];
};
shared uint localCount1;
shared uint localCount2;
shared uint base1;
shared uint base2;
void main() {
    if(gl_LocalInvocationIndex==0u) {
        localCount1=0u; localCount2=0u;
    }
    barrier();
    ivec3 tile=ivec3(gl_GlobalInvocationID);
    uint flags=0u;
    if(tileCount>=1 && tileCount<=32 && all(lessThan(tile,ivec3(tileCount))))
        flags=imageLoad(dirtyTiles,tile+ivec3(96,0,0)).r;
    uint i1=0u,i2=0u;
    if((flags&1u)!=0u) i1=atomicAdd(localCount1,1u);
    if((flags&2u)!=0u) i2=atomicAdd(localCount2,1u);
    barrier();
    if(gl_LocalInvocationIndex==0u) {
        base1=0u; base2=0u;
        if(localCount1!=0u) base1=atomicAdd(count1,localCount1);
        if(localCount2!=0u) base2=atomicAdd(count2,localCount2);
    }
    barrier();
    uint index=uint(tile.x+tileCount*(tile.y+tileCount*tile.z));
    if((flags&1u)!=0u) tasks1[base1+i1]=index;
    if((flags&2u)!=0u) tasks2[base2+i2]=index;
}
