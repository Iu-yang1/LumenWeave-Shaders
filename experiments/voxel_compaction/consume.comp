#version 430 core
// Readback probe: one invocation per compacted workgroup.
layout(local_size_x=1) in;
layout(r32ui,binding=0) writeonly uniform uimage3D visited;
uniform int tileCount;
uniform int radius;
layout(std430,binding=0) readonly buffer ActiveTiles {
    uint count1; uint y1; uint z1; uint pad1;
    uint count2; uint y2; uint z2; uint pad2;
    uint tasks1[32768];
    uint tasks2[32768];
};
void main() {
    uint i=gl_WorkGroupID.x;
    uint count=radius==1 ? count1 : count2;
    if(i>=count || tileCount<1 || tileCount>32) return;
    uint n=uint(tileCount);
    uint index=radius==1 ? tasks1[i] : tasks2[i];
    ivec3 p=ivec3(index%n,(index/n)%n,index/(n*n));
    imageStore(visited,p,uvec4(1u));
}
