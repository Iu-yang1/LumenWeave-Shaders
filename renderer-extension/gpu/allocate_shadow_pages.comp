#version 430 core
layout(local_size_x=64) in;
const uint INVALID=0xffffffffu;
layout(std430,binding=0) readonly buffer Requests {uint count;uint requestOverflow;uint requestCapacity;uint pad;uint ids[];};
layout(std430,binding=1) buffer Owners {uint owner[];};
layout(std430,binding=2) buffer Table {uvec4 page[];};
layout(std430,binding=3) buffer Free {uint freeCount;uint cursor;uint freeSlots[];};
layout(std430,binding=4) readonly buffer Revisions {uint revisions[];};
layout(std430,binding=5) buffer DrawPages {uint drawCount;uint overflow;uint drawCapacity;uint reserved;uvec4 draws[];}; // id, slot, revision, ticket
uniform uint virtualCount;
uniform uint frameTicket;
void main(){
    uint request=gl_GlobalInvocationID.x;
    if(request>=min(count,requestCapacity))return;
    uint id=ids[request]; // compacted bitset guarantees unique ids
    if(id>=virtualCount)return;
    uvec4 p=page[id];
    uint revision=revisions[id];
    if(p.x==INVALID){
        uint index=atomicAdd(cursor,1u);
        if(index>=freeCount){atomicOr(overflow,1u);return;}
        p=uvec4(freeSlots[index],revision,0u,0u);
        owner[p.x]=id;
    }
    if(p.y!=revision){p.y=revision;p.z=0u;}
    page[id]=p;
    if(p.z==0u){
        uint index=atomicAdd(drawCount,1u);
        if(index<drawCapacity)draws[index]=uvec4(id,p.x,revision,frameTicket);
        else atomicOr(overflow,1u);
    }
}
