#version 430 core
// One thread per physical slot. Caller clears freeCount, cursor, drawCount,
// overflow before dispatch and orders all stages with storage barriers.
layout(local_size_x=64) in;
const uint INVALID=0xffffffffu;
layout(std430,binding=0) readonly buffer Selected {uint selected[];};
layout(std430,binding=1) buffer Owners {uint owner[];};
layout(std430,binding=2) buffer Table {uvec4 page[];}; // slot, revision, valid, reserved
layout(std430,binding=3) buffer Free {uint freeCount;uint cursor;uint freeSlots[];};
uniform uint physicalCount;
uniform uint virtualCount;
void main(){
    uint slot=gl_GlobalInvocationID.x;
    if(slot>=physicalCount)return;
    uint id=owner[slot];
    bool retained=false;
    if(id<virtualCount)retained=(selected[id>>5u]&(1u<<(id&31u)))!=0u;
    if(retained)return;
    if(id<virtualCount)page[id]=uvec4(INVALID,0u,0u,0u);
    owner[slot]=INVALID;
    freeSlots[atomicAdd(freeCount,1u)]=slot;
}
