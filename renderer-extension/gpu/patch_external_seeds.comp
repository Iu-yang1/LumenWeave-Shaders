#version 430 core
layout(local_size_x=4,local_size_y=4,local_size_z=4) in;
layout(r16ui,binding=0) readonly uniform uimage3D externalSeeds;
layout(r32ui,binding=1) coherent uniform uimage3D occupancy;
layout(std430,binding=0) readonly buffer Bricks {ivec4 bricks[];};
uniform ivec3 gridOrigin;
uniform ivec3 gridOriginResidue;
uniform int gridSize;
shared uint touched;
ivec3 supportAddress(ivec3 tile){
    int side=gridSize/4;
    int index=tile.x+side*(tile.y+side*tile.z);
    int base=2*gridSize+(gridSize+63)/64+1;
    return ivec3(index%gridSize,(index/gridSize)%gridSize,base+index/(gridSize*gridSize));
}
void main(){
    uint lane=gl_LocalInvocationIndex;
    if(lane==0u)touched=0u;
    barrier();
    ivec4 brick=bricks[gl_WorkGroupID.x];
    ivec3 world=brick.xyz+ivec3(gl_LocalInvocationID);
    ivec3 cell=world-gridOrigin;
    ivec3 firstTile=(brick.xyz-gridOrigin)>>2;
    if(all(greaterThanEqual(cell,ivec3(0)))&&all(lessThan(cell,ivec3(gridSize)))){
        ivec3 source=ivec3(brick.w&255,(brick.w>>8)&255,(brick.w>>16)&255)+ivec3(gl_LocalInvocationID);
        uint seed=imageLoad(externalSeeds,source).r;
        ivec3 target=gridOriginResidue+cell;
        target-=ivec3(greaterThanEqual(target,ivec3(gridSize)))*gridSize;
        target.z+=gridSize+(gridSize+63)/64+1;
        imageStore(occupancy,target,uvec4(seed));
        ivec3 relative=cell/4-firstTile;
        atomicOr(touched,1u<<uint(relative.x+2*(relative.y+2*relative.z)));
    }
    barrier();
    if(lane==0u)for(uint index=0u;index<8u;index++)if((touched&(1u<<index))!=0u){
        ivec3 offset=ivec3(int(index&1u),int((index>>1u)&1u),int(index>>2u));
        imageAtomicOr(occupancy,supportAddress(firstTile+offset),2u);
    }
}
