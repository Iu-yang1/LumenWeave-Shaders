#version 430 core
// Experimental GPU request compaction. The host resets count/overflow and
// issues GL_SHADER_STORAGE_BARRIER_BIT / VK equivalent before consuming.
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Requests { uint requested[]; };
layout(std430,binding=1) buffer Compact {
    uint count;
    uint overflow;
    uint capacity;
    uint pad;
    uint pages[];
};
uniform uint virtualPageCount;
shared uint localCount;
shared uint groupBase;
void main(){
    uint lane=gl_LocalInvocationIndex;
    if(lane==0u)localCount=0u;
    barrier();
    uint page=gl_GlobalInvocationID.x;
    bool needed=false;
    if(page<virtualPageCount)needed=(requested[page>>5u]&(1u<<(page&31u)))!=0u;
    uint slot=0u;
    if(needed)slot=atomicAdd(localCount,1u);
    barrier();
    if(lane==0u){groupBase=0u;if(localCount!=0u)groupBase=atomicAdd(count,localCount);}
    barrier();
    if(needed){
        uint destination=groupBase+slot;
        if(destination<capacity)pages[destination]=page;
        else atomicOr(overflow,1u);
    }
}
