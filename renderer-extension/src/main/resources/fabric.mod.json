{
  "schemaVersion": 1,
  "id": "lumenweave_renderer",
  "version": "${version}",
  "name": "LumenWeave Renderer Extension",
  "description": "Experimental event-driven section producer and renderer backend contracts",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.lumenweave.renderer.client.RendererExtension"
    ]
  },
  "mixins": [
    "lumenweave-renderer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loaderVersion}",
    "minecraft": "${minecraft}",
    "java": ">=${javaVersion}",
    "sodium": "${sodiumVersion}"
  },
  "suggests": {
    "iris": "*"
  }
}
